# Hadj Omra Resor — exempelmiljö
# Kopiera till .env för lokal utveckling.
# Produktion: värden sätts via GitHub Actions Secrets + skickas till servern.

# --- Databas ---
# Lokalt: kör postgres med samma credentials via docker compose -f docker-compose.dev.yml up
DATABASE_URL="postgresql://hajj:hajj@localhost:5432/hajj?schema=public"

# --- Auth.js ---
# Generera en stark slumpsträng: openssl rand -base64 48 | tr -d '\n=+/'
AUTH_SECRET="byt-mig-till-en-stark-slumpstring"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- App ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Filuppladdning (resedokument) ---
# Var uppladdade dokument lagras. I produktion = Docker-volymen /app/uploads.
# Lokalt utan Docker: peka mot en skrivbar katalog, t.ex. ./.uploads
UPLOADS_DIR="/app/uploads"

# --- Seed (initial admin) ---
# Sätts en gång vid första deploy så du kan logga in i /admin
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Postgres (för docker compose) ---
POSTGRES_PASSWORD="hajj"

# --- E-postleverans (Resend) ---
# Skapa konto på resend.com, verifiera domänen, kopiera API-nyckeln hit.
# Saknas nyckeln köas mejlen som QUEUED men skickas inte (graceful degrade).
RESEND_API_KEY=""
SITE_EMAIL_FROM="Hadj Omra Resor <no-reply@hajj.karimkhalil.se>"

# --- Worker / cron ---
# Slumpa en token (t.ex. openssl rand -hex 32). Skyddar /api/cron/email-worker
# så bara cron-jobbet kan trigga utskick.
WORKER_TOKEN=""

# --- Domän + ACME (för Caddy) ---
DOMAIN="hajj.karimkhalil.se"
ACME_EMAIL="info@hajj.karimkhalil.se"

# Hadj Omra Resor — exempelmiljö
# Kopiera till .env för lokal utveckling.
# Produktion: värden sätts via GitHub Actions Secrets + skickas till servern.

# --- Databas ---
# Lokalt: kör postgres med samma credentials via docker compose -f docker-compose.dev.yml up
DATABASE_URL="postgresql://hajj:hajj@localhost:5432/hajj?schema=public"

# --- Auth.js ---
# Generera en stark slumpsträng: openssl rand -base64 48 | tr -d '\n=+/'
AUTH_SECRET="byt-mig-till-en-stark-slumpstring"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- App ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Seed (initial admin) ---
# Sätts en gång vid första deploy så du kan logga in i /admin
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Postgres (för docker compose) ---
POSTGRES_PASSWORD="hajj"

# --- Domän + ACME (för Caddy) ---
DOMAIN="hajj.karimkhalil.se"
ACME_EMAIL="info@hajj.karimkhalil.se"
